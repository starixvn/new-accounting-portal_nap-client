  <NapSettings Environment="UAT" EnableDirectLogin="1" SiteId="99" UnauthorizeUrl="~/Auth/AccessDenied" EnableReCheckin="false" HubUrl="" ServiceUrls="http://nap_api_netcore.nexdev.net:8787">
